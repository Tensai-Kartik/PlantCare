# ==============================================================================
# PlantCare Backend Environment Configuration Template
# Copy this file to .env and fill in your values (do not commit .env to Git)
# ==============================================================================

ENV=development
FRONTEND_URL=http://localhost:5173
DEFAULT_MODEL=efficientnet_b0

# Optional: Google Gemini API Key for zero-shot open-world diagnosis & agronomist explanations
# Get a free API key at: https://aistudio.google.com/
# Leave empty for automatic local offline ensemble fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODE=always
