# ==============================================================================
# Master .gitignore for PlantCare (Full-Stack AI Project)
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Node / Frontend Artifacts
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Configurations
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporary Scratch Files & OS Caches
scratch/
*.tmp
*.temp
.system_generated/
*.log

# Coverage & Test Artifacts
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
