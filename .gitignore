# ==============================================================================
# Master .gitignore for PlantCare (Full-Stack AI Project)
# ==============================================================================

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE SECRETS)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.*.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert
*.pfx

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node / Frontend Artifacts
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Configurations
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Temporary Scratch Files, Media & OS Caches
scratch/
scratch_*
*.tmp
*.temp
.system_generated/
*.log
.tempmediaStorage/
.user_uploaded/

# Coverage & Test Artifacts
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
